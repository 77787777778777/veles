{
  "manifest_version": 3,
  "name": "veles tab bridge",
  "version": "0.2.1",
  "key": "",
  "description": "Explicitly share the selected tab with your local veles agent.",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "host_permissions": [],
  "background": {"scripts": ["background.js"], "service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Connect this tab to veles", "default_popup": "popup.html"},
  "browser_specific_settings": {
    "gecko": {"id": "veles@7778777.online", "strict_min_version": "128.0"}
  }
}
