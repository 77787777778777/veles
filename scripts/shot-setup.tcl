#!/usr/bin/env wish
# scripts/shot-setup.tcl — the inner half of shot-setup.sh.
#
# Sources the SHIPPING setup.tcl and stubs only the wire (::vapi), the
# state blob (::vstate), the status bar, placement and the title strip —
# so the wizard under the camera is the real proc, filled with fixture
# answers. Walks every step, shoots each, and shoots one mid-German-swap
# to show the re-text on an OPEN window (the plan's headline behaviour).
#
# tk_messageBox is stubbed to answer "no" so `cancel` never blocks on a
# dialog the camera cannot dismiss; nothing here calls it anyway.

set dir [file join [file dirname [file normalize [info script]]] .. veles-desktop lib]

source [file join $dir paths.tcl]
source [file join $dir theme.tcl]
::vt::palette_synthwave ::vt::T
source [file join $dir i18n.tcl]
::vi18n::init
package require json

# ── the wire + collaborators, stubbed ───────────────────────────────
namespace eval ::vapi {
    variable state [dict create first_run true config_exists false \
        config_path /home/operator/.config/veles/config.toml \
        env_path /home/operator/.config/veles/.env env_exists false \
        sections [dict create]]
    # A realistic preview: the token-plan provider, a model table, the
    # desktop + a2a defaults — exactly what setup_plan emits.
    variable preview "# veles configuration — generated by the setup wizard.
# Re-run `veles setup` or the desktop's Setup… to regenerate;
# the previous file is backed up to config.toml.bak, never clobbered.

\[model]
provider = \"ali-token-plan-personal\"
default = \"deepseek-v4-flash-0731\"

\[\[custom_providers]]
name = \"ali-token-plan-personal\"
base_url = \"https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1\"
key_env = \"ALI_TOKEN_PLAN_PERSONAL_API_KEY\"
api_mode = \"chat_completions\"

\[platforms.desktop]
enabled = true

\[platforms.a2a]
enabled = true
"
    proc get_json {path {ms 0}} { variable state; return $state }
    proc post_json {path body} {
        variable preview
        if {$path eq "/api/setup/preview"} {
            return [dict create ok true config_toml $preview \
                secrets [list ALI_TOKEN_PLAN_PERSONAL_API_KEY] \
                notes [list {writing the first [acl] owner flips this box into CURATED mode}]]
        }
        if {$path eq "/api/setup/apply"} {
            return [dict create ok true \
                config_path /home/operator/.config/veles/config.toml \
                config_backup "" env_path /home/operator/.config/veles/.env \
                env_written true secrets_needed [list ALI_TOKEN_PLAN_PERSONAL_API_KEY] \
                notes {} reloaded true]
        }
        return [dict create ok 1]
    }
    proc json_raw {text} { return [list ::vapi::__json__ $text] }
    proc json_string {s} { return [json_raw "\"$s\""] }
    proc json_bool {v} { return [json_raw [expr {$v ? "true" : "false"}]] }
    proc _json_value {v} { return "{}" }   ;# the shot never inspects the body
    proc json_strings {items} { return [json_raw "\[\]"] }
    # api.tcl's decoder, as setup.tcl calls it on a thrown refusal.
    proc reason {err} { return $err }
}
namespace eval ::vstate {
    variable blob {}
    variable error ""
    proc get {key {default ""}} { variable blob; if {[dict exists $blob $key]} { return [dict get $blob $key] }; return $default }
    proc put {key value} { variable blob; dict set blob $key $value; return 1 }
}
namespace eval ::vstatus { proc set_msg {m} {} }
namespace eval ::vplace { proc centered {w width height args} { wm geometry $w ${width}x${height}+40+30 } }
namespace eval ::vtitle {
    proc attach {w title args} {
        # A real in-app strip would need titlebar.tcl's full drag/grab
        # machinery; for the shot a simple accent label reads the same.
        # Packed FIRST, but _paint calls this before any other slave
        # exists — so -before would name nothing. Just pack it and let
        # the later slaves pack after it.
        catch { destroy $w.vtitlebar }
        ttk::frame $w.vtitlebar
        ttk::label $w.vtitlebar.t -text $title -font {TkDefaultFont 10 bold} \
            -foreground $::vt::T(accent)
        pack $w.vtitlebar.t -side left -padx 8
        ttk::button $w.vtitlebar.close -text "✕" -width 3
        pack $w.vtitlebar.close -side right -padx {2 4}
        pack $w.vtitlebar -side top -fill x
    }
}
namespace eval ::va11y {
    proc name {w label} {}
    proc tab_order {widgets} {}
}
rename tk_messageBox tk_messageBox_real
proc tk_messageBox {args} { return no }

# setup.tcl builds its pages on ::vmanage's scroll frame.
source [file join $dir manage.tcl]
source [file join $dir setup.tcl]

# Fill the wizard with a believable answer set so the shots show real
# content, not empty fields.
proc fill_answers {} {
    set ::vsetup::v(provider_idx) 0
    set ::vsetup::v(provider_name) "ali-token-plan-personal"
    set ::vsetup::v(base_url) "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"
    set ::vsetup::v(key_env) "ALI_TOKEN_PLAN_PERSONAL_API_KEY"
    set ::vsetup::v(api_mode) "chat_completions"
    set ::vsetup::v(model) "deepseek-v4-flash-0731"
    set ::vsetup::v(default_provider) "ali-token-plan-personal"
    set ::vsetup::v(telegram) 1
    set ::vsetup::v(irc_server) "irc.libera.chat"
    set ::vsetup::v(irc_port) 6697
    set ::vsetup::v(irc_tls) 1
    set ::vsetup::v(irc_nick) "veles"
    set ::vsetup::v(irc_channels) "#veles #veles-dev"
    set ::vsetup::v(acl_idx) 1
    set ::vsetup::v(acl_owner) "telegram:123456789"
}

set out $::env(OUT_DIR)
proc shoot {name} {
    global out
    # FULL `update`, not `update idletasks`: idletasks runs queued redraws
    # but never drains the X event queue, so Expose-driven painting —
    # which is what a listbox's item text waits for — never happens and
    # the captured PNG shows an empty (but populated!) listbox. A minimal
    # repro with `update` rendered the same listbox perfectly; the first
    # cut of this harness shipped "the language list is empty" shots that
    # were a capture artifact, not a UI bug.
    update
    after 80
    update
    catch { exec import -window root [file join $out "$name.png"] } e
    if {[info exists e] && $e ne ""} { puts "shot $name failed: $e" }
}

# The wish MAIN window (`.`) exists whether we want it or not, and `import
# -window root` captures the whole screen — so an unmapped-but-present `.`
# paints a second empty window over the shot and the wizard reads as
# "clipped / overlapping / no title bar". Withdraw it and size the root to
# the wizard, so the PNG is the wizard and nothing else.
wm withdraw .

# Ground truth on the layout, printed rather than eyeballed: does any step's
# content exceed the window it is packed into? Tk clips silently, so a
# required-height > allocated-height pair IS a clipping bug.
proc layout_report {tag} {
    set w .setup_wizard
    if {![winfo exists $w]} { puts "layout $tag: no window"; return }
    update idletasks
    set wh [winfo height $w]
    set ww [winfo width $w]
    set need 0
    foreach c [pack slaves $w] {
        incr need [winfo reqheight $c]
    }
    set overflow [expr {$need > $wh ? "OVERFLOW by [expr {$need - $wh}]px" : "fits"}]
    puts [format "layout %-14s window %dx%d  chrome needs %dpx  %s" $tag $ww $wh $need $overflow]
    # The body's own content, which is what actually clips.
    if {[winfo exists $w.body]} {
        set bh [winfo height $w.body]
        set bneed [winfo reqheight $w.body]
        puts [format "layout %-14s body %dpx allocated, %dpx requested %s" $tag $bh $bneed \
            [expr {$bneed > $bh ? "CLIPPED" : "ok"}]]
    }
}

# Open, then walk 0→6 shooting each step by name. The seventh `next`
# (from the summary) IS "Write it" — it applies and paints the finish
# screen, so no separate _apply call.
::vsetup::open
fill_answers
set names {01-welcome 02-provider 03-model 04-telegram 05-irc 06-acl 07-summary}
set ::vsetup::cur 0
::vsetup::_paint
foreach n $names {
    layout_report $n
    shoot $n
    ::vsetup::next
}

# The walk's last `next` wrote and painted it already.
layout_report 08-done
shoot 08-done

# Mid-swap: reopen on the provider step, switch to German, and shoot the
# SAME step re-texted — the "a live swap re-texts an open wizard" pin,
# as a picture.
::vsetup::_run_again
fill_answers
set ::vsetup::cur 1
::vsetup::_paint
::vi18n::use de
update idletasks
shoot 09-provider-de

::vi18n::use en
after 80
exit 0
