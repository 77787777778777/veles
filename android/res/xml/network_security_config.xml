<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP to this phone's own gateway only: the notifier
  (Notifier.java) reads its desktop API on 127.0.0.1, which never leaves
  the device. Android refuses cleartext by default, everywhere else it
  stays refused.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
