 /*
+ * True when the lowercased family name contains word.
+ */
+
+static int
+FamilyHas(const char *family, const char *word)
+{
+    char lower[128];
+    int i;
+
+    for (i = 0; family[i] != '\0' && i < (int) sizeof (lower) - 1; i++) {
+	char c = family[i];
+
+	lower[i] = (c >= 'A' && c <= 'Z') ? c - 'A' + 'a' : c;
+    }
+    lower[i] = '\0';
+    return strstr(lower, word) != NULL;
+}
+
+/*
+ *-------------------------------------------------------------------------
+ *
+ * SdlTkFontFamilyForChar --
+ *
+ *	The family of a regular (not bold, not italic) face with a glyph
+ *	for ch, for text drawn outside Tk's own font fallback: the
+ *	decoration frame's title. Sans faces come first, then any.
+ *
+ * Results:
+ *	The family name, owned by the face table, or NULL.
+ *
+ *-------------------------------------------------------------------------
+ */
+
+const char *
+SdlTkFontFamilyForChar(int ch)
+{
+    Tcl_HashSearch search;
+    Tcl_HashEntry *hPtr;
+    const char *found = NULL;
+    int pass;
+
+    Tcl_MutexLock(&fontMutex);
+    for (pass = 0; (pass < 2) && (found == NULL); pass++) {
+	hPtr = Tcl_FirstHashEntry(&fileFaceHash, &search);
+	while (hPtr != NULL) {
+	    GlyphIndexHash *ghash = (GlyphIndexHash *) Tcl_GetHashValue(hPtr);
+	    const char *family = ghash->familyName;
+
+	    if ((ghash->styleFlags &
+		 (FT_STYLE_FLAG_BOLD | FT_STYLE_FLAG_ITALIC)) ||
+		(strchr(family, '-') != NULL)) {
+		goto next;
+	    }
+	    if ((pass == 0) && (FamilyHas(family, "mono") ||
+		(FamilyHas(family, "serif") && !FamilyHas(family, "sans")))) {
+		goto next;
+	    }
+	    if (!ghash->hashLoaded) {
+		FileFaceKey *ffKey;
+
+		ffKey = (FileFaceKey *) Tcl_GetHashKey(&fileFaceHash, hPtr);
+		SdlTkLoadGlyphHash(ghash, ffKey, 0);
+	    }
+	    if (Tcl_FindHashEntry(&ghash->hash, INT2PTR(ch)) != NULL) {
+		found = family;
+		break;
+	    }
+next:
+	    hPtr = Tcl_NextHashEntry(&search);
+	}
+    }
+    Tcl_MutexUnlock(&fontMutex);
+    return found;
+}
