+/*
+ * The title font is DejaVu Sans, which has no kana, han, hangul,
+ * Devanagari or Ethiopic: a dialog titled in Japanese drew a row of
+ * boxes. A character it lacks is drawn in the first regular sans face
+ * that has it, as Tk's own text falls back, at the title's size. The
+ * faces are kept, one per family.
+ */
+
+#define TITLE_FALLBACKS 8
+
+static struct {
+    const char *family;
+    XFontStruct *font;
+} titleFallback[TITLE_FALLBACKS];
+static int nTitleFallback = 0;
+
+static XFontStruct *
+TitleFontForChar(char *p)
+{
+    const char *family;
+    char fontname[256];
+    int i;
+
+    if (SdlTkFontHasChar(_DFInfo.titlebar_font, p)) {
+	return _DFInfo.titlebar_font;
+    }
+    for (i = 0; i < nTitleFallback; i++) {
+	if ((titleFallback[i].font != NULL) &&
+	    SdlTkFontHasChar(titleFallback[i].font, p)) {
+	    return titleFallback[i].font;
+	}
+    }
+    family = SdlTkFontFamilyForChar(((unsigned int *) p)[0]);
+    if (family == NULL) {
+	return _DFInfo.titlebar_font;
+    }
+    for (i = 0; i < nTitleFallback; i++) {
+	if (titleFallback[i].family == family) {
+	    return _DFInfo.titlebar_font;	/* it would not load */
+	}
+    }
+    if (nTitleFallback == TITLE_FALLBACKS) {
+	return _DFInfo.titlebar_font;
+    }
+    snprintf(fontname, sizeof (fontname),
+	     "-unknown-%s-normal-r-normal-*-%d-*-*-*-*-*-ucs-4",
+	     family, SdlTkX.dec_font_size);
+    titleFallback[nTitleFallback].family = family;
+    titleFallback[nTitleFallback].font =
+	XLoadQueryFont(SdlTkX.display, fontname);
+    if (titleFallback[nTitleFallback].font == NULL) {
+	nTitleFallback++;
+	return _DFInfo.titlebar_font;
+    }
+    return titleFallback[nTitleFallback++].font;
+}
