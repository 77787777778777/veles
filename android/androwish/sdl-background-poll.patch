+/* Bionic has always had sem_timedwait. Without this SDL_SemWaitTimeout
+   polls with SDL_Delay(1): the timer thread's every wait was ~1000
+   wake-ups a second, foreground and background. */
+#define HAVE_SEM_TIMEDWAIT 1
 
 #define SIZEOF_VOIDP 4
 
--- a/jni/SDL2/src/events/SDL_events.c	2026-10-04 21:16:58.520882784 +0200
