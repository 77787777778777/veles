+#endif
+
 /*#define SDL_DEBUG_EVENTS 1*/
 
 /* An arbitrary limit so we don't have unbounded growth */
@@ -676,7 +681,16 @@
                 /* Timeout expired and no events */
                 return 0;
             }
+#ifdef __ANDROID__
+            /* AndroWish keeps this loop running while the activity is
+               paused (SDL_ANDROID_BLOCK_ON_PAUSE=0, so Tcl's timers and
+               sockets carry on). Nothing is drawn then and the only
+               event that matters is the resume: 4 polls a second, not
+               100, which kept a core 3-5% busy in the background. */
+            SDL_Delay(Android_Paused ? 250 : 10);
+#else
             SDL_Delay(10);
+#endif
             break;
         default:
             /* Has events */
