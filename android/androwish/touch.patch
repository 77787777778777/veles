+/*
+ * How long a finger is held for the right button, and how far it may
+ * wander meanwhile, in milliseconds and pixels: the device's own long
+ * press timeout and twice its touch slop (Android's tolerance for a
+ * long press), which the activity puts in the environment before Tk
+ * starts. Any motion at all used to cancel the long press, so a finger
+ * held still on a phone's screen, which never is, scrolled instead.
+ */
+
+static int
+TranslateEnv(const char *name, int dflt, int min)
+{
+    const char *value = getenv(name);
+    int n = (value != NULL) ? atoi(value) : 0;
+
+    return (n >= min) ? n : dflt;
+}
+
+static int
+TranslateHold(void)
+{
+    static int hold = -1;
+
+    if (hold < 0) {
+	hold = TranslateEnv("SDLTK_LONGPRESS_MS", 500, 200);
+    }
+    return hold;
+}
+
+static int
+TranslateSlop(void)
+{
+    static int slop = -1;
+
+    if (slop < 0) {
+	slop = 2 * TranslateEnv("SDLTK_TOUCH_SLOP", 0, 1);
+	if (slop < SdlTkX.nearby_pixels) {
+	    slop = SdlTkX.nearby_pixels;
+	}
+    }
+    return slop;
+}
+
