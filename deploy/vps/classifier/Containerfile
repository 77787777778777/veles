# deploy/vps/classifier/Containerfile
# The /tcl output scorer: Detoxify unbiased-toxic-roberta int8-ONNX on
# CPU, behind a stdlib HTTP server. Built as the `veles` user on the VPS
# (or anywhere); the model is NOT in the image — it is mounted read-only
# from /srv/pool/veles/classifier/model so a re-export does not rebuild
# the image.
FROM docker.io/library/python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704

# Pinned wheels, CPU-only. onnxruntime + tokenizers + numpy is the whole
# runtime; torch/transformers are export-time only and stay out.
RUN pip install --no-cache-dir --root-user-action=ignore \
        onnxruntime==1.19.2 \
        tokenizers==0.20.3 \
        numpy==2.1.3

WORKDIR /srv
COPY veles-classifier.py /srv/veles-classifier.py

# No USER: the quadlet runs it keep-id:uid=1000 (the host `veles` user),
# which owns the mounted model (veles, 0640) — same shape as the gateway.
EXPOSE 8800
# Model dir is mounted RO by the quadlet; VELES_CLASSIFIER_MODEL points at it.
ENV VELES_CLASSIFIER_MODEL=/model \
    VELES_CLASSIFIER_HOST=0.0.0.0 \
    VELES_CLASSIFIER_PORT=8800 \
    VELES_CLASSIFIER_MAX_LEN=512

ENTRYPOINT ["python3", "/srv/veles-classifier.py"]
