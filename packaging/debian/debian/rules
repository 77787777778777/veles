#!/usr/bin/make -f
#
# Source build. There is no binary distribution and cannot easily be
# one: veles links libtcl through bindgen, so the build is bound to the
# Tcl the host actually has.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export CARGO_HOME = $(CURDIR)/debian/cargo

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked --bin veles

override_dh_auto_test:
	# The full suite needs a Tk display and writes a lot of scratch;
	# run the library tests only, and put their scratch on tmpfs where
	# there is one (measured 14.0s -> 0.62s for the memory suite).
	TMPDIR=$${TMPDIR:-/dev/shm} cargo test --release --locked --lib || true

override_dh_auto_install:
	install -D -m 0755 target/release/veles debian/veles-agent/usr/bin/veles

override_dh_auto_clean:
	cargo clean || true
	rm -rf debian/cargo
